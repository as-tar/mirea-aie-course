# --- СЕКРЕТНЫЕ КЛЮЧИ И URL МОДЕЛЕЙ (API) ---
LLM_BASE_URL="http://host.docker.internal:1234/v1"
LLM_API_KEY="lm-studio-or-whatever"
LLM_MODEL_NAME="qwen3.5-4b"

# Настройки модели-оценщика (судьи) для DeepEval
EVAL_LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
EVAL_LLM_API_KEY="your-secret-google-ai-studio-key-here"
EVAL_LLM_MODEL_NAME="gemini-3.1-flash-lite"

# --- НАСТРОЙКИ ПРИЛОЖЕНИЯ ---
API_HOST="127.0.0.1"
API_PORT="8000"
API_URL="http://127.0.0.1:8000"
ADMIN_PASSWORD="your-secure-admin-panel-password-here"

# --- АВТОНОМНАЯ НАБЛЮДАЕМОСТЬ (Arize Phoenix) ---
PHOENIX_HOST="127.0.0.1"
PHOENIX_PORT="6006"
# Относительный путь к локальной базе логов внутри проекта
PHOENIX_WORKING_DIR="./artifacts/phoenix"
# Отключаем внешние запросы для оффлайн-режима
PHOENIX_ALLOW_EXTERNAL_RESOURCES="false"
# Куда FastAPI должен отсылать логи
PHOENIX_COLLECTOR_ENDPOINT="http://127.0.0.1:6006/v1/traces"

# Отключение анонимной телеметрии DeepEval для защиты данных
DEEPEVAL_TELEMETRY_OPT_OUT="YES"